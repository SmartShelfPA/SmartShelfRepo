{
  "name": "smartshelf",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "lint": "expo lint",
    "desktop:dev": "concurrently -k -n expo,electron -c green,blue \"cross-env EXPO_PUBLIC_API_BASE_URL=https://smartshelf-api.onrender.com/api expo start --web --port 8081 --clear\" \"wait-on http://127.0.0.1:8081 && electron desktop/main.js\"",
    "desktop:export": "cross-env EXPO_PUBLIC_API_BASE_URL=https://smartshelf-api.onrender.com/api expo export --platform web",
    "desktop:build": "npm run desktop:export && node desktop/build-win.js",
    "desktop:build:mac": "npm run desktop:export && electron-builder --mac --projectDir desktop --config desktop/electron-builder.yml",
    "desktop:build:dir": "npm run desktop:export && electron-builder --dir --projectDir desktop --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^12.0.0",
    "@config-plugins/react-native-pdf": "^12.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.1.8",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "openai": "^6.36.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.0",
    "eslint-config-expo": "^10.0.0",
    "expo-dev-client": "~6.0.21",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.4"
  },
  "private": true
}
