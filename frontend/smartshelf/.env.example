# Copy to `.env` in this folder (never commit real secrets).

# Django API — Expo Go / local dev only (LAN IP). Release APK/AAB ignores this unless set in EAS secrets at build time.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.72:8000/api

# Release builds: set the same variable in EAS (public HTTPS URL), then rebuild:
#   eas secret:create --name EXPO_PUBLIC_API_BASE_URL --value "https://YOUR-TUNNEL.ngrok-free.app/api"
# See docs/MOBILE_API_SETUP.md

# IGCSE static exam simulator (GitHub Pages or local Vite preview)
EXPO_PUBLIC_IGCSE_SIMULATOR_BASE_URL=https://YOUR-USER.github.io/igcse-study-agent/
# Optional hub default: ?set=chemistry-the-mole
EXPO_PUBLIC_IGCSE_SIMULATOR_DEFAULT_SET=

# Optional — OpenAI for practice explanations (prefer backend proxy in production)
# EXPO_PUBLIC_OPENAI_API_KEY=

# Server-side (Docker / production) — required for WAEC/JAMB questions + AI explanations in release APK:
# ALOC_ACCESS_TOKEN=your-aloc-token
# OPENAI_API_KEY=sk-...
